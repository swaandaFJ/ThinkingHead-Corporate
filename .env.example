# Copy this file to .env.local and fill in what you have. Nothing here is secret —
# NEXT_PUBLIC_ values are visible in the browser by design.

# The live site's address (no trailing slash). Used for canonical URLs, sitemap, share previews.
NEXT_PUBLIC_SITE_URL=https://thinkinghead.ng

# Your form service endpoint, e.g. https://formspree.io/f/abc1234
NEXT_PUBLIC_FORM_ENDPOINT=

# Set to "true" while building/testing: forms log to the browser console and show
# the success message WITHOUT sending anything. Never leave this on in production.
NEXT_PUBLIC_FORM_DRY_RUN=true

# Optional analytics (leave blank to load nothing)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
